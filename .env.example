# API key của kie.ai — lấy tại https://kie.ai/api-key
KIE_API_KEY=your_kie_api_key_here

# App key chặn người lạ truy cập (tự sinh chuỗi ngẫu nhiên, chia sẻ cho người được phép)
APP_ACCESS_KEY=your_random_app_access_key_here

# Cloudflare R2 (bucket private là đủ — app tự sinh presigned URL; optional public base)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=image-gen-history
R2_PUBLIC_BASE_URL=


# Cloudflare D1
D1_DATABASE_ID=fdcd9cd3-9c3e-4b7d-8f8a-6bc1336da01d
D1_DATABASE_NAME=image-gen